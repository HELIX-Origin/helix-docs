# Normalize line endings across platforms so agents on Windows, Linux, and
# macOS see byte-identical files and the working tree never churns.
# This overrides core.autocrlf for every matched path.
* text=auto eol=lf

# Explicit text types
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.svg       text eol=lf
*.gemspec   text eol=lf

# Binary types (never convert)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
